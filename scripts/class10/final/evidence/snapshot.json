   "content": {
    "prompt": "The distance between the points (a, 0) and (0, b) is",
    "stimulus": null,
    "options": [
     "a + b",
     "root(a^2 - b^2)",
     "|a - b|",
     "root(a^2 + b^2)"
    ],
    "correct_answer": "root(a^2 + b^2)",
    "explanation": "The distance formula gives root((a - 0)^2 + (0 - b)^2) = root(a^2 + b^2)."
