  },
  {
   "id": "01111ce0-6e9c-4fdc-89a7-fb39ce3ca67f",
   "external_ref": "C10-2627-MATH-REQ001-REASS-013",
   "content": {
    "prompt": "Given that root 3 is irrational, show that 5 - root 3 is irrational.",
    "stimulus": null,
    "options": null,
    "correct_answer": "If 5 - root 3 = r were rational then root 3 = 5 - r would be rational, contradicting the given. So 5 - root 3 is irrational.",
    "explanation": "Subtraction of rationals keeps a number rational, so a rational value would make root 3 rational."
   },
