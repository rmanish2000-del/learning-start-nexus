   "id": "c56bbb9e-381c-4e0a-b401-074d1ca79b3f",
   "external_ref": "C10-2627-MATH-REQ001-DIAG-012",
   "content": {
    "prompt": "Given that root 5 is irrational, show that 3 - 2 root 5 is irrational.",
    "stimulus": null,
    "options": null,
    "correct_answer": "If 3 - 2 root 5 were rational and equal to r, then root 5 = (3 - r)/2 would be rational, contradicting the given. Hence 3 - 2 root 5 is irrational.",
    "explanation": "The argument isolates root 5 using only rational operations, so a rational value for the expression would force a rational value for root 5."
   },
   "content_sha256": "e30a208be73884c0cd73b5e456ee25be54831929fbc4ab699ac5ee258e87eeb6",
   "status": "approved",
   "verification_state": "unverified",
   "verification_tier": null,
