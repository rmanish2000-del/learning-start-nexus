@@ -0,0 +1,41 @@
+import { describe, it, expect } from "vitest";
+import { sanitizeReturnPath } from "../return-path";
+
+const bad = [
+  "//evil.com",
+  "https://evil.com",
+  "/\\evil.com",
+  "\\\\evil.com",
+  "/\\/evil.com",
+  "\\/evil.com",
+  "//\\evil.com",
+  "/\t/evil.com",
+  "/\n/evil.com",
+  "/%2F%2Fevil.com",
+  "%2F%2Fevil.com",
+  "https%3A%2F%2Fevil.com",
+  "/%5Cevil.com",
+  "/%5C/evil.com",
+  "/%2F\\evil.com",
+  "/\\%2Fevil.com",
+  "/%252F%252Fevil.com",
+  "javascript:alert(1)",
+  " /exam-pattern",
+  "",
+  "evil.com",
+];
+
+describe("sanitizeReturnPath", () => {
+  it.each(bad)("rejects %j", (v) => {
+    expect(sanitizeReturnPath(v)).toBeUndefined();
+  });
+  it("rejects non-strings", () => {
+    expect(sanitizeReturnPath(undefined)).toBeUndefined();
+    expect(sanitizeReturnPath(42)).toBeUndefined();
+    expect(sanitizeReturnPath({})).toBeUndefined();
+  });
+  it("keeps valid internal paths", () => {
+    expect(sanitizeReturnPath("/exam-pattern")).toBe("/exam-pattern");
+    expect(sanitizeReturnPath("/parent?tab=report&x=1#gaps")).toBe("/parent?tab=report&x=1#gaps");
+  });
+});
